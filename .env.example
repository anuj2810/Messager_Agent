# ============================================================
# AI Messenger Agent - Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to git!
# Ref: Security §4 - No hardcoded secrets
# ============================================================

# --- Application ---
APP_NAME=AI Messenger Agent
DEBUG=false
SECRET_KEY=change-me-to-a-random-string-in-production

# --- Database (PostgreSQL 15+) ---
# Ref: Tech Stack §1.2.1, Database Design §1
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/messenger_agent
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=5

# --- WhatsApp Business API ---
# Ref: Architecture §2.2, Security §3.1
WHATSAPP_API_TOKEN=your-whatsapp-api-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_VERIFY_TOKEN=your-webhook-verify-token
WHATSAPP_APP_SECRET=your-app-secret-for-hmac
WHATSAPP_API_URL=https://graph.facebook.com/v18.0

# --- OpenAI API ---
# Ref: Tech Stack §1.3.1, §1.3.2
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=300
OPENAI_TIMEOUT=2.5

# --- LLM Circuit Breaker ---
# Ref: Architecture §3.7, Design §2.6
LLM_MAX_RETRIES=2
LLM_CIRCUIT_BREAKER_THRESHOLD=3
LLM_CIRCUIT_BREAKER_TIMEOUT=30

# --- AI Context & Token Budget ---
# Ref: AI Modeling §4.2
TOKEN_BUDGET_TOTAL=1200
TOKEN_BUDGET_OUTPUT=300
TOKEN_BUDGET_PERSONALITY=200
TOKEN_BUDGET_CONTEXT=700
CONTEXT_WINDOW_SIZE=5

# --- Delay Simulation ---
# Ref: Architecture §3.9
DELAY_MIN_MS=500
DELAY_MAX_MS=2000

# --- Rate Limiting ---
# Ref: Security §9
RATE_LIMIT_PER_MINUTE=60

# --- Logging ---
# Ref: Tech Stack §4.1
LOG_LEVEL=INFO
LOG_RETENTION_DAYS=30

# --- Observability ---
# Ref: Architecture §11
SLO_RESPONSE_TIME_MS=3000
SLO_ERROR_RATE_PERCENT=1.0
